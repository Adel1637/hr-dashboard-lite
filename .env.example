# ---------------------------------------------------------------
# Kit Dashboard RH Lite — configuration
# Copiez ce fichier en .env puis adaptez les valeurs.
# ---------------------------------------------------------------

# development | production
# En production, l'application refuse de démarrer sans JWT_SECRET.
APP_ENV=development

# Identité de l'application (marque blanche)
APP_NAME=Dashboard RH
APP_COMPANY=Votre entreprise
# Couleur d'accent unique, utilisée par l'interface ET les graphiques
APP_ACCENT=#0D9488
# Chemin d'un logo servi depuis frontend/ (laisser vide pour aucun logo)
APP_LOGO=
# Langue par défaut : fr | en
APP_DEFAULT_LANG=fr

# Version Pro : page de présentation et affichage des encarts « Pro »
# (onglets verrouillés, mentions discrètes). Mettez false pour les masquer.
PRO_URL=
SHOW_PRO_HINTS=true

# --- Sécurité -----------------------------------------------------
# Générez une valeur longue et aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Compte administrateur créé au premier démarrage s'il n'existe aucun compte.
# Laissez ADMIN_PASSWORD vide pour qu'un mot de passe aléatoire soit généré
# et affiché une seule fois dans les journaux.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origines autorisées (CORS), séparées par des virgules.
# Vide = même origine uniquement (recommandé).
CORS_ORIGINS=

# Limites de requêtes (par adresse IP et par minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=10

# --- Données ------------------------------------------------------
DATA_DIR=./data
# Taille maximale d'un fichier importé, en mégaoctets
MAX_UPLOAD_MB=25
# Durée de vie du cache des indicateurs, en secondes
CACHE_TTL_SECONDS=600
